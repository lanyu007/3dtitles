<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".shapeload.MyShapeLoadActivity">

    <!-- WorldWindow container -->
    <FrameLayout
        android:id="@+id/globe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Status and Projection information panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#F5F5F5">

        <!-- Status text overlay -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="#80000000"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:text="Loading Shapefile..."
            android:layout_marginBottom="4dp" />

        <!-- Projection information overlay -->
        <TextView
            android:id="@+id/projection_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="#80000000"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:text="Projection: Unknown" />

    </LinearLayout>

</LinearLayout>